# abs-umpires environment template. Names only, no values. Copy this file to
# .env and fill it in locally. .env is gitignored and is never committed.
#
# One name carries a value: B2_BUCKET. A bucket name is not a secret, and SOP
# W1.12 fixes it to abs-umpires-raw.
#
# Anything left empty must degrade to a skip with a message, not a crash. The
# MotherDuck and B2 checks in ops/smoke.sh are written that way on purpose.

# Backblaze B2, the private mirror for raw pulls (SOP W1.9). The bucket is
# private because a Release asset on a public repo would be redistribution of
# MLB-derived raw data. A B2 key ID is "00" followed by lowercase hex;
# .gitleaks.toml carries a rule for that shape.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=abs-umpires-raw

# MotherDuck, the warehouse (SOP W1.10). Unset means dbt --target prod and the
# duckdb ATTACH check skip rather than fail.
MOTHERDUCK_TOKEN=

# Market data. Neither is read in phase 01.
ODDS_API_KEY=
KALSHI_API_KEY=

# shinyapps.io deploy credentials for the app under app/.
SHINYAPPS_NAME=
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=

# Absolute path to the data tree. It is the gitignored data/ directory at the
# repository root unless the tree has been moved to another volume.
ABS_DATA_ROOT=
