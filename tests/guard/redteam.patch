 fit_surfaces <- function(con) {
   d <- surface_frame(con)
+  d <- dplyr::filter(d, analysis_set == '@H@')
   message(nrow(d), " open pitches")
   stop("R/ch1/20_surfaces.R is a stub; the owning W3 step writes the fit.")
 }
